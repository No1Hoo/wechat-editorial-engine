# 环境变量模板（复制为 .env 使用）
# 微信公众号 API
WECHAT_APPID=wx1234567890abcdef
WECHAT_APPSECRET=0123456789abcdef0123456789abcdef

# 远端发布机配置（若使用本地直发可不配）
PUBLISHER_REMOTE_HOST=your-remote-vps
PUBLISHER_REMOTE_USER=ubuntu
PUBLISHER_REMOTE_PORT=22
PUBLISHER_REMOTE_PATH=/opt/wechat-publisher/releases/active

# 运行模式: local / remote
DELIVERY_TRANSPORT_MODE=remote
