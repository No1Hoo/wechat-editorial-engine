{%- macro picture(img) -%}
<section style="margin:26px 0 34px"><img src="{{ img_urls.get(img.key,img.key) }}" style="display:block;width:100%"/><p style="margin:8px 0 0;font-size:12px;color:#8a8175;text-align:left">{{ img.caption }}</p></section>
{%- endmacro -%}
<section style="font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;font-size:16px;line-height:1.92;letter-spacing:0.4px;color:#24221f;padding:0 6px;text-align:justify">
<!-- custom_visual_judgment: fruit_ledger_editorial -->
{%- set hook = lead_hook or lead_quote -%}
{%- if hook %}
<section style="margin:14px 0 24px;padding:0 0 20px;border-bottom:1px solid #dcd6cb"><p style="margin:0;font-family:'Songti SC',SimSun,serif;font-size:16.5px;line-height:1.88;color:#3d3831">{{ hook }}</p></section>
{%- endif -%}
{%- if lead_image %}{{ picture(lead_image) }}{% endif -%}
{%- for sec in sections %}
<h2 style="margin:38px 0 18px;{% if not loop.first %}padding-top:20px;border-top:1px solid #e2ddd3;{% endif %}border-left:1px solid #fff;padding-left:1px;font-size:21px;color:#1c1a17;text-align:left">{{ sec.title }}</h2>
{%- for p in sec.paragraphs %}<p style="margin:0 0 18px">{{ p|safe }}</p>{% endfor -%}
{%- if sec.items_box -%}
{%- if sec.items_box.get('style_variant') == 'ledger' %}
<section style="margin:24px 0 26px;padding:18px 18px 14px;background:#f6f3ec;border-top:2px solid #2b2723;border-bottom:1px solid #cfc8bc;font-size:14.5px;line-height:1.45;text-align:left">
<p style="margin:0 0 10px;font-size:13px;font-weight:700;color:#5c5449">{{ sec.items_box.title }}</p>
{%- for it in sec.items_box['items'] %}
<section style="display:table;width:100%;border-bottom:1px solid #e4dfd5;padding:10px 0">
<section style="display:table-cell;width:60%"><b>{{ it.name }}</b><br/><span style="font-size:12px;color:#756d62">{{ it.desc|safe }}</span></section>
<section style="display:table-cell;text-align:right"><b style="font-size:18px">{{ it.value }}</b><span style="font-size:11.5px;color:#756d62"> 元{% if it.share %} · {{ it.share }}{% endif %}</span></section>
</section>
{%- endfor -%}
{%- if sec.items_box.get('summary_left') %}
<section style="display:table;width:100%;padding:12px 0 2px;font-size:12.5px;color:#5c5449">
<section style="display:table-cell;width:58%">{{ sec.items_box.summary_left|safe }}</section>
<section style="display:table-cell;text-align:right">单箱净利 <b style="font-size:21px;color:#9e2a2b">{{ sec.items_box.summary_highlight }}</b> 元</section>
</section>
{%- endif %}
</section>
{%- else %}
<section style="margin:24px 0 26px;text-align:left">
{%- if sec.items_box.title %}<p style="margin:0 0 10px;font-size:12.5px;font-weight:600;color:#857c70">{{ sec.items_box.title }}</p>{% endif -%}
{%- for it in sec.items_box['items'] %}
<p style="margin:0;padding:12px 0;border-top:1px solid #e2ddd3;{% if loop.last %}border-bottom:1px solid #e2ddd3;{% endif %}font-size:14px;line-height:1.78;color:#575148"><b style="font-size:15px;color:#24221f"><span style="color:#9a9083;margin-right:8px">0{{ loop.index }}</span>{{ it.name }}</b><br/>{{ it.desc|safe }}</p>
{%- endfor %}
</section>
{%- endif -%}
{%- endif -%}
{%- if sec.callout %}
<section style="margin:24px 0 26px;padding:16px 18px;background:#f6f3ec;border-left:2px solid #9e2a2b">
<p style="margin:0 0 8px;font-size:13px;font-weight:700;color:#8c2526;text-align:left">{{ sec.callout.title }}</p>
<p style="margin:0;font-size:14.5px;line-height:1.85;color:#3d3831">{{ sec.callout.content|safe }}</p>
</section>
{%- endif -%}
{%- if sec.quote_card %}
<section style="margin:28px 6px;padding:18px 0;border-top:1px solid #c9c1b4;border-bottom:1px solid #c9c1b4">
<p style="margin:0 0 10px;font-family:'Songti SC',SimSun,serif;font-size:17px;line-height:1.9;color:#38332c">“{{ sec.quote_card.quote_text }}”</p>
<p style="margin:0;font-size:12px;color:#8a8175;text-align:right">—— {{ sec.quote_card.source_title }}</p>
</section>
{%- endif -%}
{%- for p in sec.extra_paragraphs|default([]) %}<p style="margin:0 0 18px">{{ p|safe }}</p>{% endfor -%}
{%- if sec.image %}{{ picture(sec.image) }}{% endif -%}
{%- if sec.extra_image %}{{ picture(sec.extra_image) }}{% endif -%}
{%- if sec.final_card %}{{ picture(sec.final_card) }}{% endif -%}
{%- endfor %}
</section>
