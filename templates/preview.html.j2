<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title>{{ title }}</title>
<style>
body { max-width: 580px; margin: 48px auto; padding: 0 22px; background: #fff; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
h1 { font-size: 27px; line-height: 1.5; letter-spacing: -0.5px; color: #211f1c; margin: 0 0 18px; font-weight: 700; }
.meta { font-size: 12px; color: #a09a90; margin-bottom: 32px; }
@media (max-width: 480px) { body { margin: 28px auto; padding: 0 20px; } h1 { font-size: 24px; } }
</style>
</head>
<body>
