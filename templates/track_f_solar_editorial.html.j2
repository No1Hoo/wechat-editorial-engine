{# This article's composition. All claims and figures come from its source. #}
{% macro picture(img) -%}
<section style="margin:28px 0 36px;"><img src="{{ img_urls.get(img.key,img.key) }}" style="display:block;width:100%;"/><p style="margin:8px 0 0;font-size:12px;line-height:1.7;color:#8d877d;text-align:left;">{{ img.caption }}</p></section>
{%- endmacro %}
<section style="font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:16px;line-height:1.95;letter-spacing:0.5px;color:#302f2c;text-align:justify;">
<!-- custom_visual_judgment: solar_editorial -->
<section style="margin:18px 0 30px;padding:0 0 20px;border-bottom:1px solid #ddd7cd;">
<p style="margin:0;font-size:16px;line-height:1.9;color:#615b52;">{{ lead_hook }}</p>
</section>
{% if sections[0].image %}{{ picture(sections[0].image) }}{% endif %}
{% for sec in sections %}
<h2 style="margin:40px 0 22px;font-size:23px;line-height:1.5;font-weight:700;color:#24221e;border-left:1px solid transparent;padding-left:1px;text-align:left;">{{ sec.title }}</h2>
{% for p in sec.paragraphs %}<p style="margin:0 0 19px;">{{ p|safe }}</p>{% endfor %}
{% if sec.items_box %}
<section style="margin:28px 0;padding:20px;background:#f5f3ee;">
<p style="margin:0 0 10px;font-size:15px;font-weight:600;color:#242421;">{{ sec.items_box.title }}</p>
{% for item in sec.items_box['items'][1:] %}
<section style="display:table;table-layout:fixed;width:100%;border-bottom:1px solid #dcd8cf;">
<section style="display:table-cell;width:52%;vertical-align:middle;padding:16px 4px 16px 0;">
<p style="margin:0;font-size:14px;line-height:1.6;color:#4a4945;">{{ item.display_label|default(item.name) }}</p>
</section>
<section style="display:table-cell;vertical-align:middle;text-align:right;padding:16px 0;">
<p style="margin:0;font-size:{{ '30' if loop.last else '25' }}px;line-height:1.2;font-weight:700;letter-spacing:-0.5px;color:{{ '#9d342c' if loop.last else '#272724' }};">{{ item.value }}<span style="font-size:11px;font-weight:400;letter-spacing:0;color:#69665f;"> 元</span></p>
</section>
</section>
{% endfor %}
<p style="margin:14px 0 0;font-size:12px;line-height:1.7;color:#6a665e;">{{ sec.items_box.note }}</p>
</section>
{% endif %}
{% if sec.callout %}
<section style="margin:26px 0;padding:18px;background:#f4f1e9;">
<p style="margin:0 0 10px;font-size:14px;font-weight:700;color:#68553c;">{{ sec.callout.title }}</p>
<p style="margin:0;font-size:14px;line-height:1.9;color:#726858;">{{ sec.callout.content|safe }}</p>
</section>
{% endif %}
{% if loop.index == 3 and sec.image %}{{ picture(sec.image) }}{% endif %}
{% if sec.quote_card %}
<section style="margin:30px 10px;padding:18px 0;border-top:1px solid #c6beb0;">
<p style="margin:0 0 12px;font-family:'Songti SC',SimSun,serif;font-size:18px;line-height:1.9;color:#5f5546;">{{ sec.quote_card.quote_text }}</p>
<p style="margin:0;font-size:12px;text-align:right;color:#9b9080;">{{ sec.quote_card.source_title }}</p>
</section>
{% endif %}
{% for p in sec.extra_paragraphs|default([]) %}<p style="margin:0 0 19px;">{{ p|safe }}</p>{% endfor %}
{% if loop.index not in [1,3] and sec.image %}{{ picture(sec.image) }}{% endif %}
{% for img in sec.images|default([]) %}{{ picture(img) }}{% endfor %}
{% if sec.golden_quote %}
<section style="margin:34px 14px;padding:22px 0;border-top:1px solid #b6a890;border-bottom:1px solid #b6a890;">
<p style="margin:0;font-family:'Songti SC',SimSun,serif;font-size:20px;line-height:1.85;color:#685439;text-align:left;">{{ sec.golden_quote }}</p>
</section>
{% endif %}
{% endfor %}
</section>
